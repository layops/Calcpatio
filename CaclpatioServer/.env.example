# JWT token şifreleme anahtarı (en az 32 karakter)
JWT_TOKEN=change-me-to-a-long-random-secret

# Token geçerlilik süresi (ör: 7d, 24h)
JWT_EXPIRES_IN=7d

# Yeni kullanıcı kaydı için yönetici güvenlik şifresi
SECRET_PASSWORD=change-me-admin-secret

# 404 mesajı
MESSAGE_404="404 Sayfa bulunamadı!"

# İstemci adresi (CORS)
CORS_ORIGIN=http://localhost:3000
